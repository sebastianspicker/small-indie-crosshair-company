{
  "name": "small-indie-crosshair-company",
  "version": "0.4.0",
  "private": true,
  "description": "Local CS2 crosshair converter with pixel previews and reproducible research.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/check.mjs",
    "audit:research": "node research/scripts/audit.mjs",
    "research:reproduce": "python3 research/scripts/reproduce.py",
    "test:browser": "python3 tests/browser/browser_smoke.py",
    "verify": "npm run check && npm run research:quant && npm test && npm run research:reproduce && npm run build",
    "corpus:build": "node research/scripts/corpus.mjs",
    "research:quant": "node research/scripts/corpus.mjs && node research/scripts/quant-study.mjs",
    "bench:quant": "node research/scripts/benchmark-quant.mjs",
    "bench:ranker": "node research/scripts/benchmark-ranker.mjs",
    "certify:inverse": "node research/scripts/certify-inverse.mjs",
    "study:decision": "node research/scripts/decision-study.mjs",
    "study:structural": "node research/scripts/structural-study.mjs",
    "study:partition": "node research/scripts/model-partition.mjs",
    "study:discriminating": "node research/scripts/discriminating-set.mjs",
    "emulator:train": "node research/scripts/train-quant-emulator.mjs",
    "modulator:train": "node research/scripts/train-residual-modulator.mjs",
    "bench:emulator": "node research/scripts/benchmark-emulator.mjs",
    "test:quant-browser": "python3 tests/browser/quant_browser.py",
    "audit:complexity": "node --expose-internals research/scripts/complexity.mjs"
  }
}
