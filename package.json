{
  "name": "small-indie-crosshair-company",
  "version": "0.3.0",
  "private": true,
  "description": "Local CS2 crosshair converter with pixel previews and reproducible research.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "audit:research": "node scripts/audit.mjs",
    "research:reproduce": "python3 scripts/reproduce.py",
    "test:browser": "python3 tests/browser_smoke.py",
    "verify": "npm run check && npm run research:quant && npm test && npm run audit:research && npm run research:reproduce && npm run build",
    "corpus:build": "node scripts/corpus.mjs",
    "research:quant": "node scripts/corpus.mjs && node scripts/quant-study.mjs",
    "bench:quant": "node scripts/benchmark-quant.mjs",
    "test:quant-browser": "python3 tests/quant_browser.py",
    "audit:complexity": "node --expose-internals scripts/complexity.mjs"
  }
}
